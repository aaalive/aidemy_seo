{
  "permissions": {
    "allow": [
      "Bash(scripts/verify.sh:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(aidemy-seo:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(pip install:*)",
      "Bash(mutmut:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*token*.json)",
      "Read(**/client_secret*.json)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "scripts/verify.sh --fast --quiet || echo 'verify --fast FAILED - fix before continuing' >&2" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "scripts/verify.sh --quiet" }]
      }
    ]
  }
}
